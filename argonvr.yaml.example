CAMERAS:
    cam1:
        url: "rtsp://user:password@192.168.1.11:554/stream"
        motion_threshold: 0.001
    cam2:
        url: "rtsp://user:password@192.168.1.12:554/stream"
        motion_threshold: 0.001

SETTINGS:
    WEB_USER: "admin"
    WEB_PASS: "ChangeMe123!"
    WEB_DIR: "./web"
    BASE_DIR: "./cameras"
    STORE_DIR: "./recordings"
    STORAGE_DEVICE: "/"
    MIN_FREE_SPACE_PCT: 15.0
    PORT: 8000
    SSL_CERT_PATH: ""
    SSL_KEY_PATH: ""
    LOG_HTTP_REQUESTS: false
    # Timeline preview resolution (320x180 is recommended for sharp scrubbing)
    SPRITE_WIDTH: 320
    SPRITE_HEIGHT: 180
    # Timeline preview JPEG compression (2 is best quality/largest size, 31 is worst quality/smallest size)
    SPRITE_QUALITY: 5
    # Recording & Spin-up Configuration
    COOLDOWN_PERIOD: 10
    MAX_RECORD_TIME: 60
    STAGGER_SPIN_UP_SECONDS: 0
    LOG_DAYS_TO_KEEP: 30