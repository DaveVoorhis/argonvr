[Unit]
Description=ArgoNVR Engine and Web Server (Combined Legacy Unit)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=root
WorkingDirectory=/home/dave/argonvr
ExecStart=/bin/bash -c '/usr/bin/python3 /home/dave/argonvr/server.py & /usr/bin/python3 /home/dave/argonvr/watchdog.py & /usr/bin/python3 /home/dave/argonvr/argonvr.py & wait -n'

# Cleanly signal the main process and ensure all child FFmpeg processes are reaped on stop/restart
KillMode=mixed
TimeoutStopSec=20

# Automatically restart if any process crashes or /health stops responding
# Tip: For isolated restarts (so a web server restart never interrupts recordings),
# prefer installing argonvr-engine.service and argonvr-web.service separately.
Restart=always
RestartSec=5
WatchdogSec=60s

# Ensure Python output is not buffered and avoid conflicting WATCHDOG=1 notifications in combined mode
Environment=PYTHONUNBUFFERED=1
Environment=ARGONVR_ENGINE_NOTIFY=0

[Install]
WantedBy=multi-user.target
